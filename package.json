{
  "name": "signoff",
  "version": "0.2.0",
  "private": true,
  "description": "A macOS menu-bar companion for basecamp/gh-signoff",
  "author": "Asrat",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:backend": "go build -trimpath -o desktop/bin/gh-signoff-service .",
    "start": "npm run build:backend && electron .",
    "start:demo": "npm run build:backend && SIGNOFF_DEMO=1 electron .",
    "test": "go test ./... && go vet ./... && node --check web/app.js && node --check desktop/main.cjs && node --check desktop/preload.cjs",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "pack:mac": "npm run build:backend && electron-builder --mac dir"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "@playwright/test": "1.62.1"
  },
  "build": {
    "appId": "com.asrat.signoff",
    "productName": "Signoff",
    "asar": true,
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop/bin/gh-signoff-service",
        "to": "bin/gh-signoff-service"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "desktop/assets/icon.png",
      "target": [
        "dir"
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSHighResolutionCapable": true
      }
    }
  }
}
